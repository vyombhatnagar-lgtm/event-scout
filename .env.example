# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# Neon Postgres connection string (Neon console → Connect → pooled connection string)
DATABASE_URL=

# Gemini API key (https://aistudio.google.com/apikey). All app AI uses Gemini Flash.
GEMINI_API_KEY=
# Optional: override the Flash model id (must contain "flash")
GEMINI_MODEL=gemini-3.8-flash

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Optional sender. Without a verified domain, Resend only delivers to your own account email.
DIGEST_FROM_EMAIL=Event Scout <onboarding@resend.dev>
# Default digest recipient until one is saved in Preferences
DIGEST_RECIPIENT_EMAIL=

# Random secret that Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
# Generate: openssl rand -hex 32
CRON_SECRET=

# Password protecting the whole app (leave empty to disable protection locally)
APP_PASSWORD=
# Random secret used to sign the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=

# Optional: your Calendly booking link (can also be set in Preferences)
CALENDLY_URL=

# Public base URL used for links in the email (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically)
APP_URL=http://localhost:3000
